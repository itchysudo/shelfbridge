{
  "manifest_version": 3,
  "name": "ShelfBridge",
  "version": "1.1.1",
  "description": "Get your reading library out of Fable and into Goodreads, StoryGraph or Pagebound. Everything runs in your own browser.",

  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "Open ShelfBridge",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webRequest"
  ],

  "host_permissions": [
    "https://fable.co/*",
    "https://api.fable.co/*"
  ]
}
